  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "dbg blink MSP430",
      "program": "${workspaceFolder}/build/bin/ir2mir",
      "args": ["${workspaceFolder}/IR2MIR/tests/msp430/blink/msp.ll",
      "-dump-file=${workspaceFolder}/IR2MIR/tests/msp430/blink/msp.elf.dump"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build"
    }, {
      "type": "lldb",
      "request": "launch",
      "name": "dbg cnt MSP430",
      "program": "${workspaceFolder}/build/bin/ir2mir",
      "args": ["${workspaceFolder}/IR2MIR/tests/msp430/cnt/cnt.ll",
      "-dump-file=${workspaceFolder}/IR2MIR/tests/msp430/cnt/cnt.elf.dump"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build"
    }, {
      "type": "lldb",
      "request": "launch",
      "name": "dbg covercnt MSP430",
      "program": "${workspaceFolder}/build/bin/ir2mir",
      "args": ["${workspaceFolder}/IR2MIR/tests/msp430/cover/cover.ll",
      "-dump-file=${workspaceFolder}/IR2MIR/tests/msp430/cover/cover.elf.dump"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build"
    }
  ]
}
